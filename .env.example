# ============================================================
# REQTRACE AI CONFIGURATION
# Copy this file to .env before running the application.
# Do not commit .env to source control.
# ============================================================

# Application
APP_NAME=REQTRACE AI
APP_ENVIRONMENT=development

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Persistent storage
CHROMA_DB_PATH=chroma_db

# ChromaDB collections
FRD_COLLECTION_NAME=frd_evidence
OBSERVATION_COLLECTION_NAME=observation_evidence
CODE_COLLECTION_NAME=code_evidence
TEST_COLLECTION_NAME=test_evidence
REVIEWS_COLLECTION_NAME=review_evidence

# Local LLM configuration
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=2048
LLM_NUM_PREDICT=512
LLM_TIMEOUT_SECONDS=120

# Embedding configuration
EMBEDDING_BATCH_SIZE=16

# Retrieval configuration
VECTOR_TOP_K=5
BM25_TOP_K=5
FUSED_TOP_K=6
FINAL_CONTEXT_LIMIT=4
MIN_RELEVANCE_SCORE=0.30

# Feature switches
ENABLE_HYBRID_RETRIEVAL=true
ENABLE_RERANKING=false
ENABLE_QUERY_EXPANSION=false
ENABLE_RESPONSE_CACHE=true
ENABLE_DEBUG_MODE=false

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/reqtrace_ai.log

# Ollama connection diagnostics
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=30
``